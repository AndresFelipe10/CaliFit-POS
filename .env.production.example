APP_NAME="CaliFit Sistema POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=https://tu-dominio.com
SUPPORT_WHATSAPP=573127704455
APP_PORT=80
COMPOSE_PROJECT_NAME=califit
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Docker MySQL Service Connection (CaliFit Producción)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=califit_pos_prod
DB_USERNAME=califit_prod_user
DB_PASSWORD=cambia_este_password_seguro_en_produccion
DB_ROOT_PASSWORD=cambia_este_root_password_seguro_en_produccion

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# Módulo de Consultas en Lenguaje Natural (IA)
AI_MODULE_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
AI_TIMEOUT_SECONDS=10

# Configuración de Producción
PROD_PORT=80
PROD_SSL_PORT=443
BACKUP_RETENTION_DAYS=7
